# Copiar este archivo a .env y completar los valores para desarrollo local.
# server/.vscode/launch.json carga este archivo automaticamente (envFile).

# ─── Server ───────────────────────────────────────────
SERVER_PORT=8080

# ─── Base de datos (PostgreSQL) ──────────────────────
DB_URL=jdbc:postgresql://localhost:5432/dda2
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_MAX_POOL_SIZE=10

# ─── JPA / Hibernate ──────────────────────────────────
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update

# ─── Multipart ────────────────────────────────────────
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ─── OpenAPI / Swagger ────────────────────────────────
API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui

# ─── Seguridad / JWT ──────────────────────────────────
JWT_ISSUER=example-issuer
JWT_SECRET=change-me-change-me-change-me-change-me-32chars
JWT_EXPIRATION_SECONDS=28800

# ─── CORS ─────────────────────────────────────────────
CORS_ALLOWED_ORIGIN_1=http://localhost:3000
CORS_ALLOWED_ORIGIN_2=http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_3=
CORS_ALLOWED_ORIGIN_4=

# ─── Cierre automático de convocatorias ─────────────
ENROLLMENT_PERIOD_EXPIRATION_CRON=0 5 0 * * *
ENROLLMENT_PERIOD_TIME_ZONE=America/Argentina/Buenos_Aires
