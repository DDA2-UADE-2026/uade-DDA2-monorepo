# Copiar este archivo a .env y completar los valores para desarrollo local.
# server/.vscode/launch.json carga este archivo automaticamente (envFile).

# ─── Server ───────────────────────────────────────────
SERVER_PORT=8080

# Crea admin / admin123 si no existe; asegura roles y permisos ADMIN/CIUDADANO.
BOOTSTRAP_ADMIN_ENABLED=true

# ─── Base de datos (PostgreSQL) ──────────────────────
DB_URL=jdbc:postgresql://localhost:5432/dda2
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
DB_MAX_POOL_SIZE=10

# ─── JPA / Hibernate ──────────────────────────────────
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update

# ─── Multipart ────────────────────────────────────────
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ─── OpenAPI / Swagger ────────────────────────────────
API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui

# ─── Seguridad / JWT ──────────────────────────────────
JWT_ISSUER=example-issuer
# Obligatorio: completar con un secreto aleatorio propio de al menos 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=28800
JWT_ROLE_SELECTION_EXPIRATION_SECONDS=300

# Cookies: false para HTTP local; true en DEV/PROD desplegados con HTTPS.
AUTH_COOKIE_SECURE=false
# Lax funciona entre app-muni-uade[-dev].x.com y api-muni-uade[-dev].x.com.
# Solo para sitios diferentes: None exige Secure=true (HTTPS).
AUTH_COOKIE_SAME_SITE=Lax

# ─── CORS ─────────────────────────────────────────────
CORS_ALLOWED_ORIGIN_1=http://localhost:5173
CORS_ALLOWED_ORIGIN_2=http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_3=
CORS_ALLOWED_ORIGIN_4=

# En DEV: CORS_ALLOWED_ORIGIN_1=https://app-muni-uade-dev.x.com
# En PROD: CORS_ALLOWED_ORIGIN_1=https://app-muni-uade.x.com
# En ambos despliegues dejar CORS_ALLOWED_ORIGIN_2/3/4 vacios.
# Configuracion completa: docs/technical/cookie-auth.md

# ─── Cierre automático de convocatorias ─────────────
ENROLLMENT_PERIOD_EXPIRATION_CRON=0 5 0 * * *
ENROLLMENT_PERIOD_TIME_ZONE=America/Argentina/Buenos_Aires
BENEFIT_GRANT_EXPIRATION_ENABLED=true
BENEFIT_GRANT_EXPIRATION_CRON=0 */5 * * * *
BENEFIT_GRANT_EXPIRATION_BATCH_SIZE=100
