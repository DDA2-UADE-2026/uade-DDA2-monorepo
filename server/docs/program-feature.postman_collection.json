{
  "info": {
    "_postman_id": "aeb11dec-9d53-47f1-9ce0-8fe4586bc5f5",
    "name": "DDA2 - Program Feature",
    "description": "Colección para probar los endpoints ciudadanos y administrativos de programas, ediciones, requisitos, beneficios e incompatibilidades. El script de colección inicializa la variable global baseUrl en http://localhost:8080 si todavía no existe. La request de login guarda automáticamente el JWT en la variable global token. Los IDs creados se mantienen como variables de colección para encadenar las requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "37274374"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login y guardar token global",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.globals.set('token', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Configurar username y password como variables de colección. Un login exitoso actualiza pm.globals.token."
          },
          "response": []
        }
      ]
    },
