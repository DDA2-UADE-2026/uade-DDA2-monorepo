Project social_development_api {
  database_type: 'PostgreSQL'
  Note: 'Modelo JPA del backend. User es la única identidad interna. Ciudadanos queda preparado como integración futura, sin FK a su base. El rol activo vive en el JWT, no en una tabla de sesiones.'
}

Enum log_action {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

Enum log_entity_type {
  permissions
  roles
  users
  enrollment_period
  application
  application_evaluation
  intervention_plan
  intervention_follow_up
  application_resolution
  benefit_grant
  benefit_grant_change
  application_visit
  application_visit_reschedule_request
  application_document
  activity
  activity_enrollment
  municipal_center
  municipal_service
  center_service
  professional_assignment
  center_opening_hour
  professional_availability
  appointment
  program
  program_edition
  program_benefit
  program_requirement
  program_document_requirement
  program_image
  program_incompatibility
}

Enum day_of_week {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

Enum application_status {
  DRAFT
  SUBMITTED
  IN_VALIDATION
  PENDING_DOCUMENTATION
  IN_EVALUATION
  IN_VISIT
  APPROVED
  REJECTED
  WAITLISTED
  CLOSED
}

Enum application_document_status {
  PENDING
  VALID
  OBSERVED
}

Enum vulnerability_level {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

Enum evaluation_priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

Enum application_visit_type {
  VISIT
  INTERVIEW
}

Enum application_visit_status {
  SCHEDULED
  CANCELLED
  REALIZED
  NOT_REALIZED
}

Enum application_visit_reschedule_request_status {
  PENDING
  APPROVED
  REJECTED
}

Enum enrollment_period_status {
  SCHEDULED
  OPEN
  SUSPENDED
  CLOSED
}

Enum activity_status {
  DRAFT
  OPEN
  CLOSED
}

Enum activity_attendance_status {
  PRESENT
  ABSENT
}

Enum appointment_status {
  CONFIRMED
  CANCELLED
}

Enum attention_result {
  ATENDIDO
  AUSENTE
}

Enum program_edition_status {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

Enum program_benefit_type {
  TAX_EXEMPTION
  HOUSING_SUBSIDY
  FOOD_ASSISTANCE
  UTILITY_SUBSIDY
}

Enum program_requirement_type {
  MIN_AGE
  MAX_INCOME
  RESIDENCY_YEARS
  HAS_CHILDREN
}

Table permissions {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
}

Table roles {
  id bigint [pk, increment]
  name varchar(50) [not null, unique]
}

Table role_permissions {
  role_id bigint [not null, ref: > roles.id]
  permission_id bigint [not null, ref: > permissions.id]

  indexes {
    (role_id, permission_id) [pk]
  }
}

Table users {
  id bigint [pk, increment]
  username varchar(80) [unique, note: 'Opcional para una futura cuenta externa. Username y password_hash deben estar ambos presentes o ambos ausentes.']
  password_hash varchar(100) [note: 'Hash BCrypt. Nunca se genera una contraseña ficticia para una identidad externa.']
  external_citizen_id varchar(255) [unique, note: 'Identificador externo opcional, independiente de la snapshot. No es una FK. Reservado para una futura vinculación con doble autenticación; no editable desde el ABM.']
  name varchar(150) [not null]
  email varchar(180) [not null]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz

  checks {
    `(username is null and password_hash is null) or (username is not null and password_hash is not null)` [name: 'ck_users_local_credentials']
  }

  Note: 'No se crean roles ni asignaciones automáticas. Cada JWT operativo contiene un solo active_role y únicamente sus permisos. Un usuario sin roles no puede obtener un JWT operativo.'
}

Table citizen_snapshot {
  user_id bigint [pk, not null]
  full_name varchar(150) [note: 'Nombre completo. Los datos personales pueden estar ausentes en una copia parcial.']
  dni varchar(50) [note: 'Texto para conservar formato y ceros iniciales. No es prueba de identidad ni una clave de vinculación.']
  address varchar(500)
  phone varchar(50)
  email varchar(180)
  created_at timestamptz [not null, note: 'Instante local de creación de la copia, asignado por la aplicación.']
  updated_at timestamptz [not null, note: 'Instante local de última actualización de la copia, actualizado por JPA. Inicialmente coincide con created_at.']

  Note: 'User 1 -> 0..1 CitizenSnapshot. Copia local opcional, sin endpoints ni sincronización implementados todavía. El vínculo externo reside en users.external_citizen_id. Ninguna entidad de negocio referencia esta snapshot.'
}

Ref: users.id - citizen_snapshot.user_id [delete: cascade]

Table user_roles {
  user_id bigint [not null, ref: > users.id]
  role_id bigint [not null, ref: > roles.id]

  indexes {
    (user_id, role_id) [pk]
  }
}

Table logs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id, note: 'Nullable; la aplicación limpia la referencia antes de eliminar un usuario.']
  action log_action [not null, note: 'Persistido como varchar(20).']
  entity_type log_entity_type [not null, note: 'Persistido como varchar(100) mediante LogEntityTypeConverter.']
  entity_id varchar(255) [not null]
  old_values jsonb
  new_values jsonb
  created_at timestamptz [not null]

  indexes {
    (entity_type, entity_id) [name: 'ix_logs_entity']
    user_id [name: 'ix_logs_user_id']
    created_at [name: 'ix_logs_created_at']
  }
}

Table municipal_center {
  id uuid [pk]
  name varchar(150) [not null]
  normalized_name varchar(150) [not null, unique]
  address varchar(255) [not null]
  phone varchar(30)
  email varchar(180)
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    active [name: 'ix_municipal_center_active']
  }

  Note: 'Centro municipal con baja lógica. El nombre normalizado usa NFC, espacios internos simples y minúsculas con Locale.ROOT.'
}

Table municipal_service {
  id uuid [pk]
  name varchar(150) [not null]
  normalized_name varchar(150) [not null, unique]
  description text [not null]
  duration_minutes integer [not null]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    active [name: 'ix_municipal_service_active']
  }

  checks {
    `duration_minutes > 0` [name: 'ck_municipal_service_positive_duration']
  }

  Note: 'Catálogo municipal centralizado y compartido por todos los centros.'
}

Table center_service {
  id uuid [pk]
  center_id uuid [not null, ref: > municipal_center.id]
  service_id uuid [not null, ref: > municipal_service.id]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (center_id, service_id) [unique, name: 'uk_center_service_center_service']
    (center_id, active) [name: 'ix_center_service_center_active']
    service_id [name: 'ix_center_service_service']
  }

  Note: 'La combinación centro-servicio es inmutable y se reactiva en lugar de duplicarse.'
}

Table center_opening_hour {
  id uuid [pk]
  center_id uuid [not null, ref: > municipal_center.id]
  day_of_week day_of_week [not null, note: 'Persistido como varchar(9).']
  start_time time [not null]
  end_time time [not null]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (center_id, day_of_week, active) [name: 'ix_center_opening_hour_center_day_active']
  }

  checks {
    `start_time < end_time` [name: 'ck_center_opening_hour_time_range']
  }

  Note: 'Franja semanal recurrente y semiabierta [inicio, fin). La aplicación impide superposiciones activas.'
}

Table professional_assignment {
  id uuid [pk]
  professional_id bigint [not null, ref: > users.id]
  center_service_id uuid [not null, ref: > center_service.id]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (professional_id, center_service_id) [unique, name: 'uk_professional_assignment_professional_center_service']
    (professional_id, active) [name: 'ix_professional_assignment_professional_active']
    center_service_id [name: 'ix_professional_assignment_center_service']
  }

  Note: 'Asigna un User con rol PROFESIONAL_CENTRO a un servicio concreto de un centro.'
}

Table professional_availability {
  id uuid [pk]
  assignment_id uuid [not null, ref: > professional_assignment.id]
  day_of_week day_of_week [not null, note: 'Persistido como varchar(9).']
  start_time time [not null]
  end_time time [not null]
  active boolean [not null, note: 'Valor inicial asignado por la aplicación: true.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (assignment_id, day_of_week, active) [name: 'ix_professional_availability_assignment_day_active']
  }

  checks {
    `start_time < end_time` [name: 'ck_professional_availability_time_range']
  }

  Note: 'Franja semanal específica de una asignación. La aplicación valida cobertura del centro y ausencia global de superposición para el profesional.'
}

Table appointment {
  id uuid [pk]
  citizen_id bigint [not null, ref: > users.id]
  professional_assignment_id uuid [not null, ref: > professional_assignment.id]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status appointment_status [not null, note: 'Persistido como varchar(20). CONFIRMED o CANCELLED.']
  slot_released_at timestamptz [note: 'En un turno CANCELLED, NULL retiene el horario profesional; con fecha queda habilitado.']
  idempotency_key varchar(128) [not null]
  request_hash varchar(64) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (citizen_id, idempotency_key) [unique, name: 'uk_appointment_citizen_idempotency']
    (citizen_id, starts_at, ends_at, status) [name: 'ix_appointment_citizen_time']
    (professional_assignment_id, starts_at, ends_at, status) [name: 'ix_appointment_assignment_time']
  }

  checks {
    `starts_at < ends_at` [name: 'ck_appointment_time_range']
  }

  Note: 'Turno concreto. HU-19 permite reprogramar un CONFIRMED futuro y cancelar reteniendo el intervalo hasta liberación manual. Se conserva el identificador e idempotency_key originales.'
}

Table community_attention {
  id uuid [pk]
  appointment_id uuid [not null, unique, ref: > appointment.id, note: 'Una constancia vigente por turno.']
  result attention_result [not null, note: 'Persistido como varchar(20); independiente del estado administrativo del turno.']
  attended_on date [note: 'Obligatorio para ATENDIDO, nulo para AUSENTE.']
  description varchar(500) [note: 'Descripción administrativa, no clínica; solo para ATENDIDO.']
  version bigint [not null, note: 'Control de correcciones concurrentes.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `(result = 'ATENDIDO' and attended_on is not null and description is not null) or (result = 'AUSENTE' and attended_on is null and description is null)` [name: 'ck_community_attention_result_data']
  }

  Note: 'HU-20: registro y correcciones del profesional del turno. El historial de auditoría solo registra metadatos, nunca las descripciones.'
}

Table activity {
  id uuid [pk]
  name varchar(200) [not null]
  description text [not null]
  location varchar(300) [not null]
  start_date date [not null]
  end_date date [not null]
  capacity integer [not null]
  status activity_status [not null, note: 'Persistido como varchar(20). Valor inicial asignado por la aplicación: DRAFT.']
  created_by bigint [not null, ref: > users.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `capacity > 0` [name: 'ck_activity_positive_capacity']
    `start_date <= end_date` [name: 'ck_activity_date_range']
  }

  Note: 'Una única entidad representa actividades, talleres, jornadas y campañas comunitarias. DRAFT puede editarse y publicarse; OPEN puede cerrarse; CLOSED es terminal.'
}

Table activity_enrollment {
  id uuid [pk]
  activity_id uuid [not null, ref: > activity.id]
  citizen_id bigint [not null, ref: > users.id]
  enrolled_at timestamptz [not null]
  attendance activity_attendance_status [note: 'Nulo hasta que un profesional registre PRESENT o ABSENT.']
  attendance_recorded_by bigint [ref: > users.id]
  attendance_recorded_at timestamptz

  indexes {
    (activity_id, citizen_id) [unique, name: 'uk_activity_enrollment_activity_citizen']
    activity_id [name: 'ix_activity_enrollment_activity']
    citizen_id [name: 'ix_activity_enrollment_citizen']
  }

  checks {
    `(attendance is null and attendance_recorded_by is null and attendance_recorded_at is null) or (attendance is not null and attendance_recorded_by is not null and attendance_recorded_at is not null)` [name: 'ck_activity_enrollment_attendance_audit']
  }

  Note: 'Inscripción confirmada de un ciudadano. El bloqueo de activity serializa la validación de cupo. La asistencia solo se registra para actividades OPEN o CLOSED.'
}

Table program {
  id uuid [pk]
  name varchar(200) [not null]
  normalized_name varchar(200) [not null, note: 'Nombre recortado y convertido a minúsculas por la aplicación.']
  objective text
  created_by bigint [not null, ref: > users.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    normalized_name [unique, name: 'uk_program_normalized_name']
  }
}

Table program_image {
  id uuid [pk]
  program_id uuid [not null, ref: > program.id]
  original_name varchar(255) [not null]
  content_type varchar(100) [not null, note: 'image/jpeg o image/png, validado contra extensión y firma binaria.']
  size_bytes bigint [not null, note: 'Máximo 10 MB.']
  content bytea [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    program_id [unique, name: 'uk_program_image_program']
  }

  Note: 'Portada opcional del programa. Como máximo existe una por programa y sus bytes solo se entregan mediante el controller público de imágenes.'
}

Table program_edition {
  id uuid [pk]
  program_id uuid [not null, ref: > program.id]
  name varchar(200) [not null]
  normalized_name varchar(200) [not null, note: 'Nombre recortado y convertido a minúsculas por la aplicación.']
  start_date date [not null]
  end_date date [not null]
  max_capacity integer [not null]
  current_enrollment integer [not null, note: 'Valor inicial asignado por la aplicación: 0.']
  status program_edition_status [not null, note: 'Persistido como varchar(30). Valor inicial asignado por la aplicación: DRAFT.']
  created_by bigint [not null, ref: > users.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (program_id, normalized_name) [unique, name: 'uk_program_edition_program_normalized_name']
  }
}

Table enrollment_period {
  id uuid [pk]
  program_edition_id uuid [not null, ref: > program_edition.id]
  open_date date [not null]
  close_date date [not null]
  status enrollment_period_status [not null, note: 'Persistido como varchar(20). Valor inicial asignado por la aplicación: SCHEDULED.']
  notes varchar(1000)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (program_edition_id, open_date, close_date) [name: 'ix_enrollment_period_edition_dates']
    (status, open_date, close_date) [name: 'ix_enrollment_period_status_dates']
    (program_edition_id, status) [name: 'ix_enrollment_period_edition_status']
  }

  checks {
    `open_date <= close_date` [name: 'ck_enrollment_period_date_range']
  }

  Note: 'Los rangos son inclusivos. La aplicación impide solapamientos y más de un período OPEN por edición. Un proceso diario cierra los períodos SCHEDULED, OPEN o SUSPENDED cuyo close_date ya pasó.'
}

Table program_benefit {
  id uuid [pk]
  program_edition_id uuid [not null, ref: > program_edition.id]
  benefit_type program_benefit_type [not null, note: 'Persistido como varchar(50).']
  description varchar(500)
  amount decimal(19,2)
}

Enum benefit_grant_status {
  ACTIVE
  SUSPENDED
  FINALIZED
  EXPIRED
}

Table benefit_grant {
  id uuid [pk]
  application_id uuid [not null, ref: > application.id, note: 'Titular derivado de la solicitud; CLOSED al finalizar o vencer su ultimo otorgamiento pendiente.']
  program_benefit_id uuid [not null, ref: > program_benefit.id]
  benefit_type program_benefit_type [not null, note: 'Copia al otorgar; no sigue cambios del catalogo.']
  description varchar(500) [note: 'Copia al otorgar; no se copia al log general.']
  amount decimal(19,2) [note: 'Copia al otorgar; no se copia al log general.']
  start_date date [not null]
  end_date date [not null]
  status benefit_grant_status [not null, note: 'ACTIVE inicial; SUSPENDED conserva reserva; FINALIZED y EXPIRED definitivos. Vencimiento automatico cuando end_date < hoy local.']
  assigned_by_user_id bigint [not null, ref: > users.id]
  assigned_at timestamptz [not null, note: 'Instante UTC de registro, precision microsegundos.']

  indexes {
    (application_id, program_benefit_id) [unique, name: 'uk_benefit_grant_application_benefit']
    (application_id, assigned_at, id) [name: 'ix_benefit_grant_application_date']
    program_benefit_id [name: 'ix_benefit_grant_benefit']
    assigned_by_user_id [name: 'ix_benefit_grant_assigned_by']
    (status, end_date, application_id) [name: 'ix_benefit_grant_expiration']
  }
  checks {
    `start_date <= end_date` [name: 'ck_benefit_grant_dates']
    `status in ('ACTIVE', 'SUSPENDED', 'FINALIZED', 'EXPIRED')` [name: 'ck_benefit_grant_status']
    `amount is null or amount >= 0` [name: 'ck_benefit_grant_amount']
    `benefit_type in ('TAX_EXEMPTION', 'HOUSING_SUBSIDY', 'FOOD_ASSISTANCE', 'UTILITY_SUBSIDY')` [name: 'ck_benefit_grant_type']
  }
  Note: 'Asignar/renovar exige solicitud APPROVED y edicion ACTIVE. Renovar conserva inicio y datos copiados y extiende fin; suspender/finalizar conserva fechas. No ocupa otro cupo. Finalizar o vencer ultimo otorgamiento ACTIVE/SUSPENDED cierra solicitud y libera una reserva. Renovar solo hasta el ultimo dia inclusivo. Bloqueos solicitud, titular, edicion y otorgamiento; historial y auditoria en una transaccion.'
}

Enum benefit_grant_change_action {
  ASSIGNED
  RENEWED
  SUSPENDED
  FINALIZED
  EXPIRED
}

Table benefit_grant_change {
  id uuid [pk]
  grant_id uuid [not null, ref: > benefit_grant.id]
  sequence_number integer [not null]
  action benefit_grant_change_action [not null]
  previous_status benefit_grant_status
  status benefit_grant_status [not null]
  previous_start_date date
  previous_end_date date
  start_date date [not null]
  end_date date [not null]
  reason varchar(1000) [note: 'Obligatorio recortado para cambios; null exclusivamente en ASSIGNED. Privado, excluido de logs.']
  responsible_user_id bigint [ref: > users.id, note: 'Null exclusivamente para EXPIRED; actor de sistema.']
  changed_at timestamptz [not null, note: 'UTC con precision de microsegundos; finalizacion efectiva inmediata.']

  indexes {
    (grant_id, sequence_number) [unique, name: 'uk_benefit_grant_change_sequence']
    responsible_user_id [name: 'ix_benefit_grant_change_responsible']
  }
  checks {
    `(action = 'EXPIRED' and responsible_user_id is null) or (action <> 'EXPIRED' and responsible_user_id is not null)` [name: 'ck_benefit_grant_change_responsible']
    `start_date <= end_date` [name: 'ck_benefit_grant_change_dates']
    `(action = 'ASSIGNED' and reason is null) or (action <> 'ASSIGNED' and reason is not null and length(trim(reason)) > 0)` [name: 'ck_benefit_grant_change_reason']
    `(action = 'ASSIGNED' and sequence_number = 1 and previous_status is null and status = 'ACTIVE' and previous_start_date is null and previous_end_date is null) or (sequence_number > 1 and previous_status is not null and previous_start_date is not null and previous_end_date is not null and start_date = previous_start_date and ((action = 'RENEWED' and previous_status in ('ACTIVE', 'SUSPENDED') and status = 'ACTIVE' and end_date > previous_end_date) or (action = 'SUSPENDED' and previous_status = 'ACTIVE' and status = 'SUSPENDED' and end_date = previous_end_date) or (action = 'FINALIZED' and previous_status in ('ACTIVE', 'SUSPENDED') and status = 'FINALIZED' and end_date = previous_end_date) or (action = 'EXPIRED' and previous_status in ('ACTIVE', 'SUSPENDED') and status = 'EXPIRED' and end_date = previous_end_date)))` [name: 'ck_benefit_grant_change_transition']
  }
  Note: 'Historial inmutable ordenado por secuencia. La migracion incorpora solamente la asignacion inicial conocida; no inventa motivos ni cambios previos.'
}

Table benefit_grant_change_requirement {
  id uuid [pk]
  change_id uuid [not null, ref: > benefit_grant_change.id]
  requirement_id uuid [not null, note: 'Identificador historico sin FK al catalogo editable.']
  type program_requirement_type [not null]
  requirement_value varchar(255) [not null]
  description varchar(500)
  fulfilled boolean [not null]
  indexes {
    (change_id, requirement_id) [unique, name: 'uk_benefit_grant_change_requirement']
  }
  checks {
    `type in ('MIN_AGE', 'MAX_INCOME', 'RESIDENCY_YEARS', 'HAS_CHILDREN')` [name: 'ck_benefit_grant_change_requirement_type']
  }
  Note: 'Copia inmutable del requisito vigente y resultado verificado al renovar. Renovacion exige todos cumplidos y documentos obligatorios VALID.'
}

Table program_requirement {
  id uuid [pk]
  program_edition_id uuid [not null, ref: > program_edition.id]
  type program_requirement_type [not null, note: 'Persistido como varchar(50).']
  value varchar(255) [not null]
  description varchar(500)
}

Table program_document_requirement {
  id uuid [pk]
  program_edition_id uuid [not null, ref: > program_edition.id]
  code varchar(50) [not null, note: 'Código dinámico normalizado a mayúsculas.']
  name varchar(150) [not null]
  description varchar(500)
  is_required boolean [not null]

  indexes {
    program_edition_id [name: 'ix_program_document_requirement_edition']
    (program_edition_id, code) [unique, name: 'uk_program_document_requirement_edition_code']
  }

  Note: 'Catálogo de documentos de una edición. La aplicación bloquea altas, cambios y bajas desde que existe la primera solicitud de la edición.'
}

Table program_incompatibility {
  program_id uuid [not null, ref: > program.id]
  incompatible_with_program_id uuid [not null, ref: > program.id]

  indexes {
    (program_id, incompatible_with_program_id) [pk]
  }

  Note: 'La aplicación almacena los UUID en orden canónico para representar cada incompatibilidad una sola vez.'
}

Table application {
  id uuid [pk]
  application_number bigint [not null, unique, note: 'Generado por application_number_seq, creada por Hibernate. Global, desde 1, incremento 1, sin reinicio anual. Puede haber saltos; no es el UUID ni MAX+1.']
  user_id bigint [not null, ref: > users.id, note: 'Titular inmutable. En presentación propia viene del JWT; en asistida de userId validado contra users. Nunca es el identificador externo de Ciudadanos.']
  registered_by_user_id bigint [not null, ref: > users.id, note: 'Registrado por: actor obtenido del JWT, inmutable. Coincide con user_id en solicitudes propias; en asistidas es el administrativo. No es el trabajador asignado.']
  program_edition_id uuid [not null, ref: > program_edition.id, note: 'Derivada de enrollment_period.program_edition_id; inmutable.']
  enrollment_period_id uuid [not null, ref: > enrollment_period.id]
  status application_status [not null, note: 'Persistido como varchar(30). Las altas finalizan en SUBMITTED; la evaluacion la lleva a IN_EVALUATION y la primera actuacion programada a IN_VISIT. Al cancelar o finalizar la ultima actuacion SCHEDULED vuelve a IN_EVALUATION. La resolucion la lleva de IN_EVALUATION a APPROVED, REJECTED o WAITLISTED, y de WAITLISTED a APPROVED o REJECTED.']
  origin_ticket_id varchar(255)
  resolution_reason varchar(1000)
  resolved_by_user_id bigint [ref: > users.id, note: 'Responsable de la ultima resolucion, obtenido del JWT; no reemplaza al trabajador asignado.']
  assigned_worker_user_id bigint [ref: > users.id]
  submitted_at timestamp [note: 'Asignado por servidor al presentar. Horario de ENROLLMENT_PERIOD_TIME_ZONE, Argentina por defecto.']
  resolved_at timestamp [note: 'Ultima resolucion: APPROVED, REJECTED o WAITLISTED. Una solicitud en espera puede resolverse de nuevo.']
  resolved_by_user_id bigint [ref: > users.id, note: 'Trabajador asignado que registro la ultima resolucion.']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  idempotency_key varchar(128) [note: 'Opcional, ASCII visible sin espacios. Comparación exacta, por usuario; persiste durante la vida de la solicitud. No representa una sesión.']
  request_hash varchar(64) [note: 'SHA-256 del payload canónico versionado; solo se almacena cuando hay Idempotency-Key.']

  indexes {
    (user_id, enrollment_period_id) [unique, name: 'uk_application_user_period']
    (user_id, idempotency_key) [unique, name: 'uk_application_user_idempotency']
    (user_id, application_number) [name: 'ix_application_user_number']
    (user_id, program_edition_id, status) [name: 'ix_application_user_edition_status']
    enrollment_period_id [name: 'ix_application_period']
    program_edition_id [name: 'ix_application_edition']
    assigned_worker_user_id [name: 'ix_application_worker']
    registered_by_user_id [name: 'ix_application_registered_by']
    resolved_by_user_id [name: 'ix_application_resolved_by']
  }

  checks {
    `(idempotency_key is null and request_hash is null) or (idempotency_key is not null and request_hash is not null)` [name: 'ck_application_idempotency']
  }

  Note: 'Presentación y auditoría en la misma transacción. El actor debe estar activo y autorizado por su rol activo. La presentación asistida permite elegir otro titular existente sin restricción de jurisdicción. Se exige período OPEN vigente y edición ACTIVE. No exige cupo ni aumenta current_enrollment. Una nueva convocatoria de la misma edición solo admite anteriores REJECTED/CLOSED; ambos flujos se serializan por titular para evitar carreras y comparten idempotencia por titular. Las consultas siempre filtran por el titular autenticado. No se elimina en cascada al eliminar personas, ediciones o convocatorias.'
}

Enum application_resolution_decision {
  APPROVED
  REJECTED
  WAITLISTED
}

Table application_resolution {
  id uuid [pk]
  application_id uuid [not null, ref: > application.id]
  previous_status application_status [not null]
  decision application_resolution_decision [not null]
  reason varchar(1000) [not null, note: 'Motivo privado, recortado, no copiado a logs.']
  resolved_by_user_id bigint [not null, ref: > users.id]
  resolved_at timestamptz [not null, note: 'Instante UTC asignado por el servidor.']

  indexes {
    (application_id, previous_status) [unique, name: 'uk_application_resolution_stage']
    (application_id, resolved_at) [name: 'ix_application_resolution_application']
    resolved_by_user_id [name: 'ix_application_resolution_responsible']
  }
  checks {
    `(previous_status = 'IN_EVALUATION' and decision in ('APPROVED', 'REJECTED', 'WAITLISTED')) or (previous_status = 'WAITLISTED' and decision in ('APPROVED', 'REJECTED'))` [name: 'ck_application_resolution_transition']
    `length(trim(reason)) > 0` [name: 'ck_application_resolution_reason']
  }
  Note: 'Historial inmutable. Exige evaluacion y ninguna actuacion SCHEDULED. Aprobar ocupa cupo; espera solo con cupo agotado. Ambas requieren elegibilidad y documentos obligatorios VALID. Rechazar admite incumplimientos.'
}

Table application_resolution_requirement {
  id uuid [pk]
  resolution_id uuid [not null, ref: > application_resolution.id]
  requirement_id uuid [not null, note: 'Identificador historico sin FK al catalogo editable.']
  type program_requirement_type [not null]
  requirement_value varchar(255) [not null]
  description varchar(500)
  fulfilled boolean [not null]

  indexes {
    (resolution_id, requirement_id) [unique, name: 'uk_application_resolution_requirement']
  }
  checks {
    `type in ('MIN_AGE', 'MAX_INCOME', 'RESIDENCY_YEARS', 'HAS_CHILDREN')` [name: 'ck_application_resolution_requirement_type']
  }
  Note: 'Copia inmutable del requisito y resultado verificado por el responsable al resolver.'
}

Enum intervention_action_status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

Table intervention_plan {
  id uuid [pk]
  application_id uuid [not null, ref: - application.id, note: 'Caso unico; ciudadano derivado de application.user_id.']
  responsible_user_id bigint [not null, ref: > users.id]
  created_at timestamptz [not null, note: 'UTC con precision de microsegundos.']
  indexes {
    application_id [unique, name: 'uk_intervention_plan_application']
    responsible_user_id [name: 'ix_intervention_plan_responsible']
  }
  Note: 'Plan unico de caso evaluado, incluso REJECTED/CLOSED. Responsable y estructura inicial inmutables; solo el trabajador asignado y responsable registra seguimientos.'
}

Table intervention_objective {
  id uuid [pk]
  plan_id uuid [not null, ref: > intervention_plan.id]
  position integer [not null]
  description varchar(1000) [not null]
  indexes {
    (plan_id, position) [unique, name: 'uk_intervention_objective_position']
  }
  checks {
    `position >= 0` [name: 'ck_intervention_objective_position']
    `length(trim(description)) > 0` [name: 'ck_intervention_objective_description']
  }
  Note: 'Objetivo inmutable. Orden recibido desde cero; cada objetivo requiere acciones en la capa de negocio.'
}

Table intervention_action {
  id uuid [pk]
  objective_id uuid [not null, ref: > intervention_objective.id]
  position integer [not null]
  description varchar(1000) [not null]
  start_date date [not null]
  due_date date [not null]
  status intervention_action_status [not null]
  indexes {
    (objective_id, position) [unique, name: 'uk_intervention_action_position']
  }
  checks {
    `position >= 0` [name: 'ck_intervention_action_position']
    `length(trim(description)) > 0` [name: 'ck_intervention_action_description']
    `start_date <= due_date` [name: 'ck_intervention_action_dates']
    `status in ('PENDING', 'IN_PROGRESS', 'COMPLETED')` [name: 'ck_intervention_action_status']
  }
  Note: 'Inicio PENDING. Solo cambia status al registrar seguimientos. Responsable derivado del plan; estructura y fechas fijas, sin reserva de agenda ni dependencia de edicion.'
}

Table intervention_follow_up {
  id uuid [pk]
  action_id uuid [not null, ref: > intervention_action.id]
  sequence_number integer [not null]
  previous_status intervention_action_status [not null]
  status intervention_action_status [not null]
  occurred_on date [not null, note: 'Desde inicio hasta hoy en zona configurada, sin retroceder respecto al seguimiento previo.']
  notes varchar(2000) [not null, note: 'Texto privado excluido de logs generales.']
  result varchar(2000) [note: 'Obligatorio para COMPLETED; privado y excluido de logs.']
  author_user_id bigint [not null, ref: > users.id]
  recorded_at timestamptz [not null, note: 'Registro UTC, independiente de la fecha real historica.']
  indexes {
    (action_id, sequence_number) [unique, name: 'uk_intervention_follow_up_sequence']
    author_user_id [name: 'ix_intervention_follow_up_author']
  }
  checks {
    `sequence_number > 0` [name: 'ck_intervention_follow_up_sequence']
    `length(trim(notes)) > 0` [name: 'ck_intervention_follow_up_notes']
    `(result is null or length(trim(result)) > 0) and (status <> 'COMPLETED' or result is not null)` [name: 'ck_intervention_follow_up_result']
    `previous_status in ('PENDING', 'IN_PROGRESS') and status in ('IN_PROGRESS', 'COMPLETED')` [name: 'ck_intervention_follow_up_transition']
  }
  Note: 'Historial inmutable. Secuencia serializada por solicitud, plan y accion. COMPLETED definitivo; vencimiento previsto no bloquea seguimiento. No altera estados ni cupos del caso.'
}

Table application_evaluation {
  id uuid [pk]
  application_id uuid [not null, unique, ref: - application.id, note: 'Relacion 1:1; una unica evaluacion vigente por solicitud.']
  vulnerability vulnerability_level [not null, note: 'Persistido como varchar(20).']
  priority evaluation_priority [not null, note: 'Persistido como varchar(20).']
  recommendation varchar(1000) [not null, note: 'Texto profesional sensible; no se copia al log de auditoria.']
  professional_user_id bigint [not null, ref: > users.id, note: 'Actor autenticado que registro la evaluacion.']
  evaluated_at timestamptz [not null, note: 'Instante UTC asignado por el servidor.']

  indexes {
    professional_user_id [name: 'ix_application_evaluation_professional']
    evaluated_at [name: 'ix_application_evaluation_evaluated_at']
  }

  checks {
    `vulnerability in ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')` [name: 'ck_application_evaluation_vulnerability']
    `priority in ('LOW', 'MEDIUM', 'HIGH', 'URGENT')` [name: 'ck_application_evaluation_priority']
  }

  Note: 'El alta bloquea la solicitud, impide duplicados, asigna al profesional autenticado y cambia la solicitud a IN_EVALUATION. La administracion permite listado filtrado y detalle, pero no correcciones ni reevaluaciones.'
}

Table application_visit {
  id uuid [pk]
  application_id uuid [not null, ref: > application.id]
  type application_visit_type [not null, note: 'VISIT o INTERVIEW; persistido como varchar(20).']
  starts_at timestamptz [not null, note: 'Instante normalizado a UTC al persistir.']
  ends_at timestamptz [not null, note: 'Calculado por el servidor a partir de startsAt y durationMinutes.']
  location varchar(300) [not null, note: 'Dato operativo potencialmente sensible; no se copia al log de auditoria.']
  responsible_user_id bigint [not null, ref: > users.id, note: 'Trabajador ya asignado a la solicitud y actor autenticado del alta.']
  status application_visit_status [not null, note: 'SCHEDULED ocupa la agenda; CANCELLED, REALIZED y NOT_REALIZED son finales y la liberan.']
  scheduled_at timestamptz [not null, note: 'Instante UTC asignado por el servidor.']
  last_rescheduled_at timestamptz [note: 'Ultima reprogramacion en UTC; null si nunca se modifico el horario o lugar.']
  cancellation_reason varchar(1000) [note: 'Obligatorio y recortado al cancelar. No se copia al log de auditoria.']
  cancelled_at timestamptz [note: 'Instante UTC de cancelacion.']
  cancelled_by_user_id bigint [ref: > users.id, note: 'Actor que cancelo la actuacion.']
  result_observations varchar(2000) [note: 'Texto profesional opcional y sensible; solo se expone en detalle autorizado.']
  result_conclusions varchar(2000) [note: 'Texto profesional opcional y sensible; solo se expone en detalle autorizado.']
  result_recorded_at timestamptz [note: 'Instante UTC asignado por el servidor al registrar el resultado.']
  result_recorded_by_user_id bigint [ref: > users.id, note: 'Responsable autenticado que registro el resultado.']

  indexes {
    application_id [name: 'ix_application_visit_application']
    (application_id, status) [name: 'ix_application_visit_application_status']
    (responsible_user_id, starts_at, ends_at, status) [name: 'ix_application_visit_responsible_time']
    result_recorded_by_user_id [name: 'ix_application_visit_result_recorded_by']
    starts_at [name: 'ix_application_visit_starts_at']
  }

  checks {
    `type in ('VISIT', 'INTERVIEW')` [name: 'ck_application_visit_type']
    `status in ('SCHEDULED', 'CANCELLED', 'REALIZED', 'NOT_REALIZED')` [name: 'ck_application_visit_status']
    `starts_at < ends_at` [name: 'ck_application_visit_time_range']
    `last_rescheduled_at is null or (last_rescheduled_at >= scheduled_at and last_rescheduled_at < starts_at)` [name: 'ck_application_visit_reschedule_data']
    `(status = 'SCHEDULED' and cancellation_reason is null and cancelled_at is null and cancelled_by_user_id is null and result_observations is null and result_conclusions is null and result_recorded_at is null and result_recorded_by_user_id is null) or (status = 'CANCELLED' and cancellation_reason is not null and length(trim(cancellation_reason)) between 1 and 1000 and cancelled_at is not null and cancelled_by_user_id is not null and result_observations is null and result_conclusions is null and result_recorded_at is null and result_recorded_by_user_id is null) or (status in ('REALIZED', 'NOT_REALIZED') and cancellation_reason is null and cancelled_at is null and cancelled_by_user_id is null and result_recorded_at is not null and result_recorded_by_user_id = responsible_user_id and result_recorded_at >= ends_at and (result_observations is null or length(trim(result_observations)) between 1 and 2000) and (result_conclusions is null or length(trim(result_conclusions)) between 1 and 2000))` [name: 'ck_application_visit_lifecycle_data']
  }

  Note: 'Admite varias actuaciones por solicitud evaluada. Las futuras SCHEDULED pueden reprogramarse o cancelarse; una solicitud ciudadana PENDING bloquea esos cambios directos y el resultado hasta su revision. Una finalizada puede cerrarse una sola vez como REALIZED o NOT_REALIZED. El titular consulta solo actuaciones de sus solicitudes mediante applications:own:visits:view.'
}

Table application_visit_reschedule_request {
  id uuid [pk]
  visit_id uuid [not null, ref: > application_visit.id]
  requested_by_user_id bigint [not null, ref: > users.id, note: 'Ciudadano autenticado titular de la solicitud.']
  reason varchar(1000) [not null, note: 'Texto ciudadano sensible; se expone solo en detalles autorizados y no se copia a auditoria.']
  status application_visit_reschedule_request_status [not null]
  requested_at timestamptz [not null, note: 'Instante UTC asignado por el servidor.']
  original_starts_at timestamptz [not null]
  original_ends_at timestamptz [not null]
  original_location varchar(300) [not null, note: 'Snapshot sensible del lugar al solicitar.']
  reviewed_by_user_id bigint [ref: > users.id, note: 'Responsable autenticado que tomo la decision.']
  reviewed_at timestamptz
  review_comment varchar(1000) [note: 'Opcional al aprobar y obligatorio al rechazar; no se copia a auditoria.']
  approved_starts_at timestamptz
  approved_ends_at timestamptz
  approved_location varchar(300) [note: 'Snapshot sensible del lugar aplicado al aprobar.']

  indexes {
    (visit_id, requested_at) [name: 'ix_visit_reschedule_request_visit_time']
    (status, requested_at) [name: 'ix_visit_reschedule_request_status_time']
    requested_by_user_id [name: 'ix_visit_reschedule_request_requested_by']
    reviewed_by_user_id [name: 'ix_visit_reschedule_request_reviewed_by']
  }

  checks {
    `status in ('PENDING', 'APPROVED', 'REJECTED')` [name: 'ck_visit_reschedule_request_status']
    `length(trim(reason)) between 1 and 1000` [name: 'ck_visit_reschedule_request_reason']
    `original_starts_at < original_ends_at and length(trim(original_location)) between 1 and 300` [name: 'ck_visit_reschedule_request_original_schedule']
    `(status = 'PENDING' and reviewed_by_user_id is null and reviewed_at is null and review_comment is null and approved_starts_at is null and approved_ends_at is null and approved_location is null) or (status = 'APPROVED' and reviewed_by_user_id is not null and reviewed_at is not null and reviewed_at >= requested_at and approved_starts_at is not null and approved_ends_at is not null and approved_starts_at < approved_ends_at and approved_location is not null and length(trim(approved_location)) between 1 and 300 and (review_comment is null or length(trim(review_comment)) between 1 and 1000)) or (status = 'REJECTED' and reviewed_by_user_id is not null and reviewed_at is not null and reviewed_at >= requested_at and review_comment is not null and length(trim(review_comment)) between 1 and 1000 and approved_starts_at is null and approved_ends_at is null and approved_location is null)` [name: 'ck_visit_reschedule_request_lifecycle']
  }

  Note: 'Historial inmutable de solicitudes ciudadanas. PostgreSQL agrega un indice unico parcial uk_visit_reschedule_request_pending sobre visit_id WHERE status = PENDING para admitir una sola pendiente por actuacion.'
}

Table intervention_follow_up_publication {
  id uuid [pk]
  follow_up_id uuid [not null, ref: > intervention_follow_up.id]
  summary varchar(2000) [not null, note: 'Resumen expresamente redactado para el ciudadano; nunca copia automatica de notes/result.']
  visible boolean [not null, note: 'False conserva la version profesional y la excluye de la consulta y totales ciudadanos.']
  published_at timestamptz [not null, note: 'UTC con microsegundos; ultima publicacion o correccion.']
  updated_at timestamptz [not null, note: 'UTC con microsegundos; ultima gestion, incluido retiro.']
  updated_by_user_id bigint [not null, ref: > users.id]
  indexes {
    follow_up_id [unique, name: 'uk_intervention_publication_follow_up']
    updated_by_user_id [name: 'ix_intervention_publication_updated_by']
  }
  checks {
    `length(trim(summary)) > 0` [name: 'ck_intervention_publication_summary']
    `published_at <= updated_at` [name: 'ck_intervention_publication_dates']
  }
  Note: 'Version publica actual opcional por seguimiento. El original permanece inmutable. Sin publicaciones automaticas de datos anteriores ni historial publico de versiones. FK y guard protegen al responsable de ultima gestion.'
}

TableGroup social_case_management {
  application
  application_evaluation
  intervention_plan
  intervention_objective
  intervention_action
  intervention_follow_up
  intervention_follow_up_publication
  application_visit
  application_visit_reschedule_request
}

Table document {
  id uuid [pk]
  original_name varchar(255) [not null]
  content_type varchar(100) [not null, note: 'application/pdf, image/jpeg o image/png, validado contra extensión y firma binaria.']
  size_bytes bigint [not null, note: 'Máximo admitido por la aplicación: 10 MB.']
  content bytea [not null, note: 'Contenido protegido. Nunca se incluye en listados, respuestas JSON ni auditoría.']
  uploaded_by_user_id bigint [not null, ref: > users.id]
  created_at timestamp [not null]

  indexes {
    uploaded_by_user_id [name: 'ix_document_uploaded_by']
  }

  Note: 'Almacenamiento privado de archivos de solicitudes. No posee un CRUD general ni una URL pública.'
}

Table application_document {
  id uuid [pk]
  application_id uuid [not null, ref: > application.id]
  requirement_id uuid [not null, ref: > program_document_requirement.id]
  document_id uuid [not null, ref: > document.id]
  status application_document_status [not null, note: 'Persistido como varchar(20). Toda carga o reemplazo queda PENDING.']
  observation varchar(1000)
  uploaded_at timestamp [not null]
  reviewed_by_user_id bigint [ref: > users.id]
  reviewed_at timestamp

  indexes {
    (application_id, requirement_id) [unique, name: 'uk_application_document_application_requirement']
    document_id [unique, name: 'uk_application_document_document']
    application_id [name: 'ix_application_document_application']
    requirement_id [name: 'ix_application_document_requirement']
    reviewed_by_user_id [name: 'ix_application_document_reviewer']
  }

  checks {
    `(status = 'PENDING' and observation is null and reviewed_by_user_id is null and reviewed_at is null) or (status = 'VALID' and observation is null and reviewed_by_user_id is not null and reviewed_at is not null) or (status = 'OBSERVED' and observation is not null and reviewed_by_user_id is not null and reviewed_at is not null)` [name: 'ck_application_document_review']
  }

  Note: 'Una sola entrega vigente por solicitud y requisito. Reemplazar conserva esta fila, cambia el Document y reinicia la revisión. El backend exige que el requisito pertenezca a la misma edición de la solicitud y serializa las mutaciones por solicitud.'
}
