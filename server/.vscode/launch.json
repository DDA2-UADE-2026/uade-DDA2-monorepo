{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ServerApplication",
            "request": "launch",
            "mainClass": "com.uade.dda2.server.ServerApplicationKt",
            "projectName": "server",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "args": "--spring.config.additional-location=file:./src/main/resources/",
            "vmArgs": "-Duser.timezone=UTC"
        },
        {
            "type": "java",
            "name": "ServerApplication (docs profile)",
            "request": "launch",
            "mainClass": "com.uade.dda2.server.ServerApplicationKt",
            "projectName": "server",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "args": "--spring.profiles.active=docs --spring.config.additional-location=file:./src/main/resources/"
        }
    ]
}
