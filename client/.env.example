VITE_SERVER_URL = /proxy
VITE_PROXY_URL = https://api-muni-uade-dev.fabriziob.com
VITE_CLIENT_URL = http://localhost:5173
DOCS_URL = https://api-muni-uade-dev.fabriziob.com/api-docs

# Auth con cookies: para API local usar VITE_SERVER_URL=http://localhost:8080
# y configurar CORS_ALLOWED_ORIGIN_1=http://localhost:5173 en server/.env.
# Detalles de HTTPS, SameSite y proxy: ../server/docs/technical/cookie-auth.md
# DEV desplegado: VITE_SERVER_URL=https://api-muni-uade-dev.x.com
#                 VITE_CLIENT_URL=https://app-muni-uade-dev.x.com
# PROD: VITE_SERVER_URL=https://api-muni-uade.x.com
#       VITE_CLIENT_URL=https://app-muni-uade.x.com
# /proxy solo existe en Vite local; en las imagenes usar la URL absoluta del BE.
