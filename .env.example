# Configuración del entorno Docker local. Copiar a .env y completar los cinco valores.
# Usar credenciales exclusivas de desarrollo; no copiar accesos de producción/Core real.
# Escribir los valores entre comillas simples si contienen $ o #.
# No subir .env a Git ni mostrar su contenido en terminales, logs o informes.

# Contraseña del usuario PostgreSQL postgres (base dda2).
DB_PASSWORD=

# Contraseña del usuario RabbitMQ module_desarrollo-social (vhost core).
RABBITMQ_PASSWORD=

# Clave de firma JWT del backend: al menos 32 caracteres ASCII aleatorios.
JWT_SECRET=

# Contraseña inicial del usuario admin: al menos 12 caracteres.
# Se usa al crear la cuenta; no cambia la contraseña de una cuenta existente.
BOOTSTRAP_ADMIN_PASSWORD=

# Secreto compartido únicamente entre el backend y el mock local de Core.
CORE_MACHINE_SECRET=
